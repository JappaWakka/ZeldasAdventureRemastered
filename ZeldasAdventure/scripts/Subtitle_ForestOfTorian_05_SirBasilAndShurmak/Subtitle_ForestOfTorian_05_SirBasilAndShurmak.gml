function Subtitle_ForestOfTorian_05_SirBasil_HailPrincessZelda(AudioPosition)
{
	if AudioPosition >=		 0.000 and AudioPosition <= 2.233 {return Localize.Subtitles.Dialogue.ForestOfTorian.SirBasil.HailPrincessZelda.Line01}
	else if AudioPosition >= 2.306 and AudioPosition <= 6.267 {return Localize.Subtitles.Dialogue.ForestOfTorian.SirBasil.HailPrincessZelda.Line02}
	else return ""
}

function Subtitle_ForestOfTorian_05_Shurmak_YouSeemTired(AudioPosition)
{
	if AudioPosition >=		 0.000 and AudioPosition <= 2.073 {return Localize.Subtitles.Dialogue.ForestOfTorian.Shurmak.YouSeemTired.Line01}
	else if AudioPosition >= 2.427 and AudioPosition <= 5.267 {return Localize.Subtitles.Dialogue.ForestOfTorian.Shurmak.YouSeemTired.Line02}
	else return ""
}