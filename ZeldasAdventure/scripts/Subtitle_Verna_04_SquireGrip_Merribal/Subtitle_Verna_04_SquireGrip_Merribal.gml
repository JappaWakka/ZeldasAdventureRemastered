//Squire Grip
function Subtitle_Verna_SquireGrip_WelcomeToOurFairVillage(AudioPosition)
{
	if AudioPosition >=		 0.000 and AudioPosition <=  2.693 {return Localize.Subtitles.Dialogue.Verna.SquireGrip.WelcomeToOurFairVillage.Line01}
	else if AudioPosition >= 2.717 and AudioPosition <=  4.427 {return Localize.Subtitles.Dialogue.Verna.SquireGrip.WelcomeToOurFairVillage.Line02}
	else if AudioPosition >= 4.573 and AudioPosition <=  7.047 {return Localize.Subtitles.Dialogue.Verna.SquireGrip.WelcomeToOurFairVillage.Line03}
	else return ""
}
